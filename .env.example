# Copy to .env and fill in values (never commit .env)

# Khalti sandbox: https://test-admin.khalti.com → API keys
# KHALTI_SECRET_KEY=test_secret_key_xxxxxxxx
# KHALTI_PUBLIC_KEY=test_public_key_xxxxxxxx

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Simulates Khalti checkout on localhost when secret key is missing (dev only)
KHALTI_DEV_MODE=true

SECRET_KEY=change-me-in-production
